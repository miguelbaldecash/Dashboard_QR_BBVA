{
  "builds": [
    {
      "src": "api/dashboard.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": ["api/cohort_ids.json"]
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/api/dashboard" },
    { "src": "/api/dashboard", "dest": "/api/dashboard" }
  ]
}
